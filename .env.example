# Anime Saga Backend Configuration

PORT=3001
NODE_ENV=development

# Firebase Admin SDK (untuk akses Firestore)
FIREBASE_PROJECT_ID=your-firebase-project-id-here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nGANTI-DENGAN-PRIVATE-KEY-ANDA\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# MongoDB (untuk data anime & media)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/anime-saga?retryWrites=true&w=majority
MONGODB_DATABASE=anime-saga

# CORS Settings (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:5173,https://animesaga.online

# API Rate Limiting
API_RATE_LIMIT_WINDOW_MS=3600000
API_RATE_LIMIT_MAX_REQUESTS=100

# Leveling Configuration
XP_COOLDOWN_HOURS=24
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_EVENTS=5

# API Key untuk proteksi endpoint (harus sama dengan VITE_BACKEND_API_KEY di frontend)
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET_KEY=ganti_dengan_secret_key_random_kamu
